# 前端镜像：多阶段构建 —— node 构建 Vue 静态产物 → nginx 托管 + 反代
# build context 为项目根目录（package.json / web/ / deploy/ 都在根下）

# 阶段 1：构建前端（用 slim/glibc 避免 esbuild 在 alpine/musl 下的兼容坑）
FROM node:20-slim AS build
# 国内服务器默认走淘宝镜像源，海外服务器可在构建时用 --build-arg 覆盖
ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --registry=$NPM_REGISTRY --no-audit --no-fund

COPY web ./web
COPY tsconfig.json ./
RUN npm run build

# 阶段 2：nginx 托管静态文件 + 反代 /api
FROM nginx:1.27-alpine
COPY --from=build /app/web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

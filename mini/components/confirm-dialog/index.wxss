.dialog-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(15,23,42,.45); box-sizing: border-box; }.dialog { width: 100%; max-width: 620rpx; padding: 36rpx; background: #fff; border-radius: 8rpx; box-sizing: border-box; }.dialog-title, .dialog-message { display: block; }.dialog-title { font-size: 34rpx; font-weight: 600; }.dialog-message { margin: 18rpx 0 30rpx; color: #6b7280; line-height: 1.6; }.dialog-actions { display: flex; gap: 18rpx; }.dialog-actions button { flex: 1; margin: 0; border-radius: 8rpx; }.dialog-actions .danger { color: #fff; background: #dc2626; }

<view wx:if="{{visible}}" class="switcher-mask" bindtap="close"><view class="switcher-sheet" catchtap="noop"><view class="switcher-head"><text class="head-spacer"></text><text class="switcher-title">切换家庭账本</text><button class="close-button" bindtap="close">×</button></view><button wx:for="{{ledgers}}" wx:key="id" data-ledger="{{item}}" bindtap="handleChange" class="switcher-item"><view class="ledger-mark">□</view><view class="ledger-copy"><text class="ledger-name">{{item.name}}</text><text class="ledger-role">{{item.role === 'OWNER' ? '所有者' : '成员'}}</text></view><text wx:if="{{item.id === currentId}}" class="mark">✓</text></button><button class="create-button" bindtap="createLedger">＋ 创建新的家庭账本</button></view></view>

.switcher-mask { position: fixed; inset: 0; z-index: 40; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }.switcher-sheet { width: 100%; max-height: 80vh; overflow-y: auto; padding: 24rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; }.switcher-head { display: grid; grid-template-columns: 58rpx 1fr 58rpx; align-items: center; margin-bottom: 18rpx; }.head-spacer { width: 58rpx; }.switcher-title { color: #151820; font-size: 30rpx; font-weight: 700; text-align: center; }.close-button { width: 58rpx; height: 58rpx; margin: 0; padding: 0; color: #667080; background: transparent; font-size: 42rpx; line-height: 58rpx; }.switcher-item { display: grid; grid-template-columns: 76rpx 1fr 42rpx; align-items: center; gap: 18rpx; width: 100%; min-height: 116rpx; margin: 0; padding: 10rpx 4rpx; border-bottom: 1rpx solid #e5e9ef; border-radius: 0; background: transparent; text-align: left; }.ledger-mark { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 13rpx; color: #3159d7; background: #eef2ff; font-size: 34rpx; font-weight: 700; }.ledger-copy { display: flex; min-width: 0; flex-direction: column; }.ledger-name { overflow: hidden; color: #151820; font-size: 26rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.ledger-role { margin-top: 7rpx; color: #8a92a1; font-size: 20rpx; }.mark { color: #3159d7; font-size: 34rpx; font-weight: 700; }.create-button { width: 100%; min-height: 82rpx; margin: 12rpx 0 0; padding: 0 4rpx; color: #3159d7; background: transparent; font-size: 24rpx; text-align: left; }

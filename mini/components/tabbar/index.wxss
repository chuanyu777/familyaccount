.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding: 10rpx 12rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  border-top: 1rpx solid #e0e5ec;
  background: rgba(255, 255, 255, .98);
}

.tab { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; margin: 0; padding: 0; border: 0; background: transparent; color: #7c8494; line-height: 1.2; }
.tab::before { position: absolute; top: -10rpx; left: 50%; width: 48rpx; height: 6rpx; border-radius: 0 0 4rpx 4rpx; background: transparent; content: ""; transform: translateX(-50%); }
.tab-icon { width: 40rpx; height: 40rpx; }
.tab-label { font-size: 19rpx; }
.tab.is-active { color: #3159d7; font-weight: 700; }
.tab.is-active::before { background: #3159d7; }

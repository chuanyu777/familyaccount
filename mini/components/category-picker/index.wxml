<view class="category-picker"><text class="field-label">{{label}}</text><view class="category-grid"><button wx:for="{{categories}}" wx:key="id" class="category-option {{item.id === value ? 'is-active' : ''}}" data-index="{{index}}" bindtap="handleTap"><category-icon icon-key="{{item.icon_key || 'other'}}" kind="expense" size="40" class="category-symbol"/><text class="category-name">{{item.name}}</text></button></view></view>

<view class="category-picker"><text class="field-label">{{label}}</text><view class="category-grid"><button wx:for="{{categories}}" wx:key="id" class="category-option {{item.id === value ? 'is-active' : ''}}" data-index="{{index}}" bindtap="handleTap"><text class="category-symbol">◇</text><text class="category-name">{{item.name}}</text></button></view></view>

.category-picker { margin-bottom: 24rpx; }.field-label { display: block; margin-bottom: 10rpx; color: #6b7280; font-size: 24rpx; }.category-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; }.category-option { display: flex; min-width: 0; min-height: 112rpx; margin: 0; padding: 10rpx 4rpx; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; border: 1rpx solid transparent; border-radius: 13rpx; color: #7c8594; background: transparent; font-size: 20rpx; line-height: 1.2; }.category-symbol { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 13rpx; color: #596273; background: #f1f3f7; font-size: 25rpx; font-weight: 700; }.category-name { overflow: hidden; max-width: 100%; text-overflow: ellipsis; white-space: nowrap; }.category-option.is-active { border-color: #cbd6f6; color: #3159d7; background: #eef2ff; font-weight: 700; }.category-option.is-active .category-symbol { color: #3159d7; background: #fff; }

<view class="auth-page">
  <view class="auth-visual" aria-hidden="true">
    <view class="ledger-mark"><view class="ledger-mark__binding"></view><view class="ledger-mark__line"></view><view class="ledger-mark__line ledger-mark__line--short"></view></view>
    <view class="coin coin--one">＋</view>
    <view class="coin coin--two">¥</view>
  </view>
  <view class="auth-copy">
    <text class="auth-title">一起记账</text>
    <text class="auth-subtitle">家庭收支、资产和负债，一本账看清楚。</text>
  </view>
  <button class="wechat-button" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin">
    <view class="wechat-icon"><view></view><view></view></view><text>微信一键登录</text>
  </button>
  <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
  <text class="auth-terms">登录即表示你同意服务条款和隐私政策</text>
</view>

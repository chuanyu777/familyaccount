@import "../../styles/theme.wxss";
.auth-page { min-height: 100vh; padding: 150rpx 48rpx 48rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; background: #f4f6f9; }
.auth-visual { position: relative; width: 270rpx; height: 230rpx; }
.ledger-mark { position: absolute; left: 53rpx; top: 42rpx; width: 132rpx; height: 152rpx; box-sizing: border-box; padding: 42rpx 28rpx; border-radius: 16rpx; background: #3159d7; box-shadow: 0 18rpx 40rpx rgba(49,89,215,.25); transform: rotate(-7deg); }
.ledger-mark__binding { position: absolute; left: 16rpx; top: -12rpx; width: 12rpx; height: 176rpx; border-radius: 6rpx; background: #121a2d; }
.ledger-mark__line { height: 8rpx; margin-top: 14rpx; border-radius: 4rpx; background: rgba(255,255,255,.92); }
.ledger-mark__line--short { width: 68%; }
.coin { position: absolute; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; font-size: 28rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(18,26,45,.14); }
.coin--one { right: 20rpx; top: 36rpx; color: #fff; background: #19765d; }
.coin--two { right: 42rpx; bottom: 15rpx; color: #121a2d; background: #f0c86a; }
.auth-copy { display: flex; flex-direction: column; align-items: center; margin-top: 20rpx; }
.auth-title { font-size: 52rpx; line-height: 1.2; font-weight: 750; }
.auth-subtitle { margin-top: 20rpx; color: #697080; font-size: 27rpx; text-align: center; }
.wechat-button { display: flex; align-items: center; justify-content: center; gap: 14rpx; width: 100%; height: 92rpx; margin-top: 86rpx; padding: 0; border-radius: 14rpx; background: #07c160; color: #fff; font-size: 30rpx; font-weight: 700; line-height: 92rpx; }
.wechat-icon { position: relative; width: 40rpx; height: 34rpx; }
.wechat-icon view { position: absolute; width: 27rpx; height: 22rpx; border: 3rpx solid #fff; border-radius: 50%; }
.wechat-icon view:last-child { right: 0; bottom: 0; width: 23rpx; height: 19rpx; background: #07c160; }
.support-button { margin-top: 20rpx; padding: 12rpx 20rpx; background: transparent; color: #697080; font-size: 23rpx; line-height: 1.5; }
.error-message { margin-top: 14rpx; color: #b84543; font-size: 24rpx; text-align: center; }
.auth-terms { margin-top: auto; color: #9aa1ad; font-size: 20rpx; }

<view class="screen-page assets-page">
  <view class="ledger-head"><button class="ledger-selector" bindtap="openLedgerSwitcher">{{ledgerName}} <text class="chevron">⌄</text></button><button class="header-action" bindtap="openAsset">＋</button></view>
  <view wx:if="{{loading}}" class="empty-state">正在加载资产…</view>
  <view wx:elif="{{errorMessage}}" class="empty-state state-error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view>
  <block wx:else>
    <view class="total-card"><text>净资产</text><strong>¥ {{totalNet}}</strong><text class="total-hint">资金 ¥{{totalAccounts}} · 资产 ¥{{totalAssets}}</text></view>
    <view class="content-section"><view class="section-title"><text>资金账户</text><button class="manage-link" bindtap="openAccount">管理</button></view><view class="account-strip"><view wx:for="{{accounts}}" wx:key="id" class="account-card" data-id="{{item.id}}" bindtap="openCalibration"><view class="asset-mark blue"><view class="card-icon"></view></view><text class="asset-name">{{item.name}}</text><text class="asset-meta">{{item.isDefault ? '默认账户' : '资金账户'}}</text><text class="account-balance">¥ {{item.balance}}</text></view><view wx:if="{{!accounts.length}}" class="empty-inline">暂无账户</view></view></view>
    <view class="content-section"><view class="section-title"><text>家庭资产</text><text class="section-title__meta">共 {{assets.length}} 项</text></view><view class="plain-list"><view wx:for="{{assets}}" wx:key="id" class="asset-row" data-id="{{item.id}}" bindtap="openSnapshot"><view class="asset-mark {{index % 2 ? 'gold' : 'blue'}}">{{index % 2 ? '⌁' : '⌂'}}</view><view class="asset-body"><text class="asset-name">{{item.name}}</text><text class="asset-meta">{{item.kind || '其他'}} · {{month}}估值</text></view><text class="asset-value">¥ {{item.value}}</text><button class="history-button" data-id="{{item.id}}" bindtap="showSnapshots">›</button></view><view wx:if="{{!assets.length}}" class="empty-inline">暂无资产</view></view></view>
    <view wx:if="{{selectedAssetId !== null}}" class="section-card"><view class="section-title"><text>市值历史</text><button size="mini" bindtap="retrySnapshots">刷新</button></view><view wx:if="{{snapshotsLoading}}" class="empty-inline">正在加载…</view><view wx:elif="{{snapshotsError}}" class="empty-inline state-error">{{snapshotsError}}</view><view wx:for="{{snapshots}}" wx:key="id" class="history-row"><text>{{item.month}}</text><text>¥{{item.value}}</text></view><view wx:if="{{!snapshotsLoading && !snapshotsError && !snapshots.length}}" class="empty-inline">暂无快照</view></view>
  </block>
  <ledger-switcher visible="{{switcherOpen}}" bindclose="closeLedgerSwitcher" />
  <tabbar current="assets" />
  <view wx:if="{{form}}" class="sheet"><view class="sheet-card"><view class="sheet-header"><button class="sheet-close" bindtap="closeForm">×</button><text class="sheet-title">{{form === 'calibrate' ? '校准余额 · ' + name : form === 'account' ? '账户' : form === 'asset' ? '资产' : '更新市值'}}</text><text class="sheet-spacer"></text></view><view wx:if="{{form === 'account' || form === 'asset'}}" class="form-row"><text>名称</text><input value="{{name}}" data-field="name" bindinput="handleInput"/></view><view wx:if="{{form === 'calibrate'}}" class="form-row"><text>实际余额</text><input type="text" value="{{value}}" data-field="value" bindinput="handleInput"/></view><money-input wx:if="{{form === 'asset' || form === 'snapshot'}}" value="{{value}}" label="{{form === 'snapshot' ? '市值' : '当前市值'}}" bindinput="handleInput" data-field="value"/><view wx:if="{{form === 'asset'}}" class="form-row"><text>类型</text><input value="{{kind}}" data-field="kind" placeholder="如不动产、投资" bindinput="handleInput"/></view><view wx:if="{{form === 'snapshot'}}" class="form-row"><text>月份</text><input type="month" value="{{month}}" data-field="month" bindinput="handleInput"/></view><view wx:if="{{form === 'snapshot'}}" class="form-row"><text>备注</text><input value="{{note}}" data-field="note" bindinput="handleInput"/></view><text wx:if="{{errorMessage}}" class="state-error">{{errorMessage}}</text><view class="actions"><button bindtap="closeForm">取消</button><button class="primary-button" bindtap="saveForm" loading="{{saving}}">保存</button></view></view></view>
</view>

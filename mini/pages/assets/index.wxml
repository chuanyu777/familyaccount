<view class="page"><view class="header"><text class="title">资产</text><view class="header-actions"><button class="primary" bindtap="openAccount">账户</button><button class="primary" bindtap="openAsset">资产</button></view></view><view wx:if="{{loading}}" class="state">正在加载资产…</view><view wx:elif="{{errorMessage}}" class="state error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view><view wx:else><view class="section"><text class="section-title">共享账户</text><view wx:for="{{accounts}}" wx:key="id" class="row"><view><text>{{item.name}} <text wx:if="{{item.archived}}" class="tag">已归档</text></text><text class="meta">余额 ¥{{item.balance}}</text></view><view class="row-actions"><button size="mini" data-id="{{item.id}}" bindtap="openAccountEdit">编辑</button><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="openCalibration">校准余额</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleAccountArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view><view wx:if="{{!accounts.length}}" class="empty">暂无账户</view></view><view class="section"><text class="section-title">资产清单</text><view wx:for="{{assets}}" wx:key="id" class="row"><view><text>{{item.name}} <text wx:if="{{item.archived}}" class="tag">已归档</text></text><text class="meta">{{item.kind || '其他'}} · ¥{{item.value}}</text></view><view class="row-actions"><button size="mini" data-id="{{item.id}}" bindtap="showSnapshots">市值历史</button><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="openSnapshot">市值</button><button size="mini" data-id="{{item.id}}" bindtap="openAssetEdit">编辑</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view><view wx:if="{{!assets.length}}" class="empty">暂无资产</view></view><view wx:if="{{selectedAssetId !== null}}" class="section"><text class="section-title">市值历史</text><view wx:if="{{snapshotsLoading}}" class="state">正在加载市值历史…</view><view wx:elif="{{snapshotsError}}" class="state error">{{snapshotsError}}<button size="mini" bindtap="retrySnapshots">重试</button></view><view wx:for="{{snapshots}}" wx:key="id" class="row"><text>{{item.month}}</text><text>¥{{item.value}}</text></view><view wx:if="{{!snapshotsLoading && !snapshotsError && !snapshots.length}}" class="empty">暂无快照</view></view></view><view wx:if="{{form}}" class="sheet"><view class="sheet-card"><text class="sheet-title">{{form === 'calibrate' ? '校准余额 · ' + name : form === 'account' ? '账户' : form === 'asset' ? '资产' : '更新市值'}}</text><view wx:if="{{form === 'account' || form === 'asset'}}" class="field"><text>名称</text><input value="{{name}}" data-field="name" bindinput="handleInput"/></view><view wx:if="{{form === 'calibrate'}}" class="field"><text>实际余额（元）</text><input type="text" value="{{value}}" data-field="value" bindinput="handleInput"/></view><text wx:if="{{form === 'calibrate'}}" class="hint">保存后直接更新余额，不生成收支记录。</text><money-input wx:if="{{form === 'asset' || form === 'snapshot'}}" value="{{value}}" label="{{form === 'snapshot' ? '市值' : '当前市值'}}" bindinput="handleInput" data-field="value"/><view wx:if="{{form === 'asset'}}" class="field"><text>类型</text><input value="{{kind}}" data-field="kind" placeholder="如不动产、投资" bindinput="handleInput"/></view><view wx:if="{{form === 'snapshot'}}" class="field"><text>月份</text><input type="month" value="{{month}}" data-field="month" bindinput="handleInput"/></view><view wx:if="{{form === 'snapshot'}}" class="field"><text>备注</text><input value="{{note}}" data-field="note" bindinput="handleInput"/></view><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><view class="actions"><button bindtap="closeForm" disabled="{{saving}}">取消</button><button class="primary" bindtap="saveForm" loading="{{saving}}">保存</button></view></view></view></view>

@import "../../styles/theme.wxss";
.header-action { width: 58rpx; height: 58rpx; margin: 0; padding: 0; border-radius: 50%; color: #3159d7; background: #e9efff; font-size: 36rpx; line-height: 58rpx; }.total-card { margin-top: 28rpx; padding: 30rpx; border-radius: 16rpx; color: #fff; background: #3159d7; }.total-card text,.total-card strong { display: block; }.total-card > text:first-child { color: rgba(255,255,255,.72); font-size: 22rpx; }.total-card strong { margin-top: 5rpx; font-size: 50rpx; }.total-hint { margin-top: 14rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }.content-section { margin-top: 36rpx; }.section-title { margin-bottom: 14rpx; }.manage-link { margin: 0; padding: 4rpx 10rpx; background: transparent; color: #3159d7; font-size: 22rpx; line-height: 1.4; }.account-strip { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }.account-card { display: flex; min-width: 0; flex-direction: column; padding: 22rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.account-card .asset-mark { margin-bottom: 15rpx; }.account-balance { margin-top: 20rpx; font-size: 27rpx; font-weight: 750; }.plain-list { overflow: hidden; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.asset-row { display: grid; grid-template-columns: 66rpx 1fr auto 32rpx; align-items: center; gap: 14rpx; min-height: 112rpx; padding: 0 18rpx; border-bottom: 1rpx solid #eef1f5; }.asset-row:last-child { border-bottom: 0; }.asset-mark { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 14rpx; font-size: 32rpx; }.asset-mark.blue { color: #3159d7; background: #e9efff; }.asset-mark.gold { color: #b7791f; background: #fff5d9; }.card-icon { width: 36rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 4rpx; }.card-icon::before { content: ""; display: block; margin-top: 6rpx; border-top: 3rpx solid currentColor; }.asset-body { display: flex; min-width: 0; flex-direction: column; }.asset-name { overflow: hidden; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.asset-meta { margin-top: 3rpx; color: #697080; font-size: 19rpx; }.asset-value { font-size: 23rpx; font-weight: 700; white-space: nowrap; }.history-button { width: 32rpx; height: 48rpx; margin: 0; padding: 0; background: transparent; color: #a2a8b3; font-size: 36rpx; line-height: 48rpx; }.empty-inline { grid-column: 1 / -1; padding: 36rpx 0; color: #8a92a1; text-align: center; font-size: 23rpx; }.history-row { display: flex; justify-content: space-between; min-height: 64rpx; align-items: center; border-bottom: 1rpx solid #eef1f5; color: #5f6878; }.sheet { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }.sheet-card { width: 100%; max-height: 91vh; overflow-y: auto; padding: 24rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; }.sheet-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.sheet-title { font-size: 32rpx; font-weight: 700; }.sheet-close { width: 52rpx; height: 52rpx; margin: 0; padding: 0; color: #5f6878; background: transparent; font-size: 44rpx; line-height: 52rpx; }.sheet-spacer { width: 52rpx; }.form-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-bottom: 16rpx; padding: 0 20rpx; border-bottom: 1rpx solid #e6eaf0; color: #5f6878; }.form-row input { flex: 1; margin-left: 20rpx; color: #151820; text-align: right; }.primary-button { margin: 0; color: #fff; background: #3159d7; border-radius: 12rpx; }.actions { display: flex; gap: 14rpx; margin-top: 28rpx; }.actions button { flex: 1; margin: 0; border-radius: 12rpx; }

@import "../../styles/theme.wxss";
.bind-page { min-height: 100vh; padding: 76rpx 36rpx; box-sizing: border-box; background: #f4f6f9; }.bind-panel { display: flex; flex-direction: column; }
.binding-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin-bottom: 38rpx; border-radius: 16rpx; background: #e6ebfb; }.screen-icon { width: 56rpx; height: 42rpx; border: 4rpx solid #3159d7; border-radius: 6rpx; }.screen-icon::after { content: ""; display: block; width: 26rpx; height: 4rpx; margin: 47rpx auto 0; border-radius: 2rpx; background: #3159d7; }.link-dot { position: absolute; right: 6rpx; bottom: 5rpx; color: #19765d; font-size: 32rpx; transform: rotate(-25deg); }
.bind-title { font-size: 43rpx; font-weight: 750; }.bind-hint { margin-top: 17rpx; color: #697080; font-size: 25rpx; line-height: 1.7; }
.field { margin-top: 58rpx; }.field > text { display: block; margin: 0 0 13rpx 3rpx; color: #555d6c; font-size: 24rpx; font-weight: 650; }.bind-input { height: 94rpx; padding: 0 24rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; font-variant-numeric: tabular-nums; letter-spacing: 5rpx; }
.binding-note { display: flex; gap: 16rpx; margin-top: 30rpx; padding: 22rpx; border-radius: 14rpx; background: #e6ebfb; }.binding-note > text { display: flex; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; border: 2rpx solid #3159d7; border-radius: 50%; color: #3159d7; font-size: 18rpx; font-weight: 700; }.binding-note view { display: flex; flex-direction: column; }.binding-note view text:first-child { font-size: 24rpx; font-weight: 700; }.binding-note view text:last-child { margin-top: 4rpx; color: #697080; font-size: 21rpx; }
.bind-button { height: 90rpx; margin-top: 50rpx; border-radius: 14rpx; background: #3159d7; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 90rpx; }.bind-button[disabled] { background: #9eafe8; color: rgba(255,255,255,.9); }.error-message { margin-top: 22rpx; color: #b84543; text-align: center; }
.preview-card { display: flex; flex-direction: column; margin-top: 34rpx; padding: 28rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(28, 43, 78, .08); }.preview-label, .preview-role { color: #697080; font-size: 23rpx; }.preview-name { margin: 10rpx 0; color: #1c2538; font-size: 32rpx; font-weight: 750; }.preview-card .bind-button { margin-top: 30rpx; }

@import "../../styles/theme.wxss";

.summary-band { margin-top: 26rpx; padding: 28rpx 28rpx 24rpx; border-radius: 16rpx; color: #fff; background: #111827; box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, .12); }
.summary-label { display: block; color: rgba(255,255,255,.68); font-size: 23rpx; }
.summary-total { display: block; margin-top: 5rpx; font-size: 48rpx; font-weight: 700; letter-spacing: 1rpx; }
.summary-pair { display: flex; gap: 42rpx; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(255,255,255,.16); color: rgba(255,255,255,.66); font-size: 23rpx; }
.summary-pair .income { margin-left: 8rpx; color: #76d3b5; font-weight: 700; }
.summary-pair .expense { margin-left: 8rpx; color: #f09a98; font-weight: 700; }
.filter-row { display: flex; gap: 4rpx; margin-top: 18rpx; padding: 5rpx; border-radius: 12rpx; background: #e9edf3; }
.filter-button { flex: 1; height: 58rpx; margin: 0; padding: 0; border-radius: 9rpx; color: #8a92a1; background: transparent; font-size: 23rpx; line-height: 58rpx; }
.filter-button.is-active { color: #151820; background: #fff; box-shadow: 0 2rpx 8rpx rgba(19,23,34,.08); font-weight: 700; }
.bell-button { position: relative; }.bell-icon { width: 24rpx; height: 27rpx; margin: 8rpx auto 0; border: 4rpx solid #151820; border-top-left-radius: 16rpx; border-top-right-radius: 16rpx; border-bottom: 0; }.bell-icon::after { content: ""; display: block; width: 10rpx; height: 4rpx; margin: 27rpx auto 0; border-radius: 3rpx; background: #151820; }.notice-dot { position: absolute; right: 7rpx; top: 5rpx; width: 11rpx; height: 11rpx; border: 3rpx solid #f4f6f9; border-radius: 50%; background: #b84543; }.calendar-icon { position: relative; width: 24rpx; height: 22rpx; border: 3rpx solid #697080; border-radius: 4rpx; }.calendar-icon::before { content: ""; position: absolute; left: -3rpx; right: -3rpx; top: 5rpx; border-top: 3rpx solid #697080; }
.transaction-list { margin-top: 28rpx; }
.transaction-row { display: flex; flex-wrap: wrap; align-items: center; min-height: 108rpx; padding: 0; border-bottom: 1rpx solid #dce2ea; background: transparent; text-align: left; }
.transaction-date { display: flex; flex-basis: 100%; justify-content: space-between; padding-top: 10rpx; color: #697080; font-size: 20rpx; }
.transaction-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-right: 18rpx; border-radius: 14rpx; color: #b84543; background: #f9e9e8; font-size: 35rpx; font-weight: 700; }
.transaction-icon.income { color: #19765d; background: #e6f4ef; }
.transaction-icon.transfer { color: #3159d7; background: #e9efff; }
.transaction-body { display: flex; flex: 1; min-width: 0; flex-direction: column; }
.transaction-title { overflow: hidden; font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.transaction-meta { margin-top: 5rpx; color: #8a92a1; font-size: 21rpx; }
.transaction-amount { margin-left: 12rpx; color: #b84543; font-size: 27rpx; font-weight: 700; white-space: nowrap; }
.transaction-amount.income { color: #19765d; }
.transaction-amount.transfer { color: #3159d7; }
.load-more { padding: 24rpx 0; text-align: center; }
.load-more button { display: inline-block; color: #3159d7; background: #e9efff; border-radius: 12rpx; font-size: 23rpx; }
.category-management { display: none; margin-top: 30rpx; }
.category-label { display: block; margin: 18rpx 0 6rpx; color: #8a92a1; font-size: 22rpx; }
.category-row { display: flex; align-items: center; justify-content: space-between; min-height: 70rpx; border-bottom: 1rpx solid #eef1f5; }
.category-actions { display: flex; gap: 8rpx; }
.category-actions button { margin: 0; color: #3159d7; background: #eef2ff; font-size: 20rpx; }
.tag { margin-left: 10rpx; color: #b7791f; font-size: 20rpx; }
.category-edit { display: flex; gap: 10rpx; margin-top: 16rpx; }
.category-edit input { flex: 1; height: 66rpx; padding: 0 16rpx; border: 1rpx solid #d8dee8; border-radius: 10rpx; background: #f8fafc; box-sizing: border-box; }
.primary-button { margin: 0; color: #fff; background: #3159d7; border-radius: 12rpx; }
.danger-button { margin: 0; color: #fff; background: #b84543; border-radius: 12rpx; }
.fab { position: fixed; right: 28rpx; bottom: 226rpx; z-index: 10; display: flex; align-items: center; gap: 8rpx; height: 76rpx; margin: 0; padding: 0 28rpx; border-radius: 40rpx; color: #fff; background: #3159d7; box-shadow: 0 12rpx 24rpx rgba(49,89,215,.28); font-size: 25rpx; font-weight: 700; }
.fab-plus { font-size: 42rpx; font-weight: 300; line-height: 1; }
.sheet { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }
.sheet-card { width: 100%; max-height: 91vh; overflow-y: auto; padding: 24rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); border-radius: 30rpx 30rpx 0 0; background: #fff; box-sizing: border-box; }
.sheet-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-close { width: 52rpx; height: 52rpx; margin: 0; padding: 0; color: #5f6878; background: transparent; font-size: 44rpx; line-height: 52rpx; }
.sheet-spacer { width: 52rpx; }
.segmented { display: flex; gap: 4rpx; margin-bottom: 22rpx; padding: 5rpx; border-radius: 12rpx; background: #e9edf3; }
.segment { flex: 1; height: 58rpx; margin: 0; padding: 0; color: #8a92a1; background: transparent; border-radius: 9rpx; font-size: 24rpx; line-height: 58rpx; }
.segment.is-active { color: #151820; background: #fff; font-weight: 700; }
.amount-input { display: flex; align-items: baseline; justify-content: center; gap: 10rpx; padding: 34rpx 0 30rpx; color: #151820; }
.amount-input text { font-size: 36rpx; font-weight: 650; }
.amount-input input { width: 270rpx; height: 82rpx; font-size: 58rpx; font-weight: 750; line-height: 82rpx; }
.amount-placeholder { color: #b8bec9; }
.quick-category { display: flex; gap: 12rpx; margin: -4rpx 0 18rpx; }.quick-category input { flex: 1; height: 66rpx; padding: 0 18rpx; border: 1rpx solid #dce1e9; border-radius: 11rpx; background: #f7f8fa; box-sizing: border-box; font-size: 22rpx; }.quick-category button { flex: none; height: 66rpx; margin: 0; padding: 0 18rpx; border-radius: 11rpx; color: #3159d7; background: #eef2ff; font-size: 21rpx; line-height: 66rpx; }
.form-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; margin-bottom: 16rpx; padding: 0 20rpx; border-bottom: 1rpx solid #e6eaf0; color: #5f6878; }
.form-row input { flex: 1; margin-left: 20rpx; color: #151820; text-align: right; }
.submit-button { width: 100%; margin-top: 20rpx; }
.detail-title { display: block; font-size: 34rpx; font-weight: 700; }
.hint { display: block; margin-top: 18rpx; color: #8a92a1; font-size: 23rpx; }
.actions { display: flex; gap: 14rpx; margin-top: 28rpx; }
.actions button { flex: 1; margin: 0; border-radius: 12rpx; }

.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; }.title { display: block; font-size: 42rpx; font-weight: 600; }.sub { color: #6b7280; font-size: 24rpx; }.primary { background: #2563eb; color: #fff; border-radius: 8rpx; }.small { width: 180rpx; margin: 0; }.filters { display: flex; gap: 16rpx; margin-bottom: 20rpx; }.filters picker { flex: 1; }.filter, .field { min-height: 78rpx; padding: 0 22rpx; display: flex; align-items: center; background: #fff; border: 1rpx solid #d7dce2; border-radius: 8rpx; box-sizing: border-box; }.state { padding: 70rpx 20rpx; text-align: center; color: #6b7280; }.error { color: #b91c1c; }.list { background: #fff; border-radius: 8rpx; }.row { display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; padding: 0 22rpx; border-bottom: 1rpx solid #eef0f2; }.row-title, .row-meta { display: block; }.row-title { font-size: 30rpx; }.row-meta { margin-top: 8rpx; color: #9ca3af; font-size: 23rpx; }.amount { font-size: 30rpx; }.amount.expense { color: #dc2626; }.amount.income { color: #15803d; }.hint { margin-top: 18rpx; color: #6b7280; font-size: 24rpx; }.sheet { position: fixed; z-index: 5; inset: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.35); }.sheet-card { width: 100%; max-height: 88vh; overflow-y: auto; padding: 34rpx 28rpx 50rpx; background: #f7f8fa; border-radius: 24rpx 24rpx 0 0; box-sizing: border-box; }.sheet-title { display: block; margin-bottom: 22rpx; font-size: 36rpx; font-weight: 600; }.sheet-card .field { margin-bottom: 20rpx; justify-content: space-between; }.sheet-card input { flex: 1; min-width: 0; text-align: right; }.actions { display: flex; gap: 16rpx; margin-top: 28rpx; }.actions button { flex: 1; border-radius: 8rpx; }.danger { color: #fff !important; background: #dc2626 !important; }

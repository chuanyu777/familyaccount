<view class="screen-page accounting-page">
  <view class="ledger-head">
    <button class="ledger-selector" bindtap="openLedgerSwitcher">{{ledgerName}} <text class="chevron">⌄</text></button>
    <button class="header-icon bell-button" bindtap="showNotice"><view class="bell-icon"></view><view class="notice-dot"></view></button>
  </view>

  <view class="month-row">
    <picker mode="date" fields="month" value="{{month}}" bindchange="handleMonthInput"><view class="month-button"><view class="calendar-icon"></view>{{monthLabel}} <text class="chevron">⌄</text></view></picker>
  </view>

  <view class="summary-band">
    <text class="summary-label">本月结余</text>
    <text class="summary-total">¥ {{snapshot ? snapshot.net : '0.00'}}</text>
    <view class="summary-pair"><text>收入 <text class="income">¥ {{snapshot ? snapshot.income : '0.00'}}</text></text><text>支出 <text class="expense">¥ {{snapshot ? snapshot.expense : '0.00'}}</text></text></view>
  </view>

  <view class="filter-row">
    <button class="filter-button {{typeFilter === '' ? 'is-active' : ''}}" data-type="" bindtap="setTypeFilter">全部</button>
    <button class="filter-button {{typeFilter === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="setTypeFilter">支出</button>
    <button class="filter-button {{typeFilter === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="setTypeFilter">收入</button>
    <button class="filter-button {{typeFilter === 'transfer' ? 'is-active' : ''}}" data-type="transfer" bindtap="setTypeFilter">转账</button>
  </view>

  <view wx:if="{{loading}}" class="empty-state">正在加载流水…</view>
  <view wx:elif="{{errorMessage}}" class="empty-state state-error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view>
  <view wx:elif="{{!items.length}}" class="empty-state">本月还没有交易</view>
  <view wx:else class="transaction-list">
    <view wx:for="{{items}}" wx:key="id" class="transaction-row" data-id="{{item.id}}" bindtap="openDetail">
      <view wx:if="{{index === 0 || items[index - 1].occurredOn !== item.occurredOn}}" class="transaction-date"><text>{{item.occurredOn}}</text><text>当日流水</text></view>
      <view class="transaction-icon {{item.type}}"><text>{{item.type === 'income' ? '↗' : item.type === 'transfer' ? '⇄' : '⌁'}}</text></view>
      <view class="transaction-body"><text class="transaction-title">{{item.note || item.categoryName || (item.sourceType === 'repayment' ? '还款' : '未分类')}}</text><text class="transaction-meta">{{item.occurredOn}} · {{item.accountName || ''}}{{item.toAccountName ? ' → ' + item.toAccountName : ''}}</text></view>
      <text class="transaction-amount {{item.type}}">{{item.type === 'income' ? '+' : item.type === 'expense' ? '-' : ''}}¥ {{item.amount}}</text>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="load-more"><text wx:if="{{loadMoreError}}" class="state-error">{{loadMoreError}}</text><button bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loading || loadingMore}}">{{loadMoreError ? '重试加载更多' : '加载更多'}}</button></view>

  <view wx:if="{{!loading && !errorMessage}}" class="category-management section-card">
    <view class="section-title"><text>分类管理</text><text class="section-title__meta">{{isOwner ? '账本所有者' : '共享分类'}}</text></view>
    <text class="category-label">支出分类</text>
    <view wx:for="{{allExpenseCategories}}" wx:key="id" class="category-row"><text>{{item.name}}<text wx:if="{{item.archived}}" class="tag">已归档</text></text><view class="category-actions"><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="startCategoryEdit">改名</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleCategoryArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view>
    <text class="category-label">收入分类</text>
    <view wx:for="{{allIncomeCategories}}" wx:key="id" class="category-row"><text>{{item.name}}<text wx:if="{{item.archived}}" class="tag">已归档</text></text><view class="category-actions"><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="startCategoryEdit">改名</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleCategoryArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view>
    <view wx:if="{{editingCategoryId !== null}}" class="category-edit"><input value="{{editingCategoryName}}" bindinput="handleCategoryEditName"/><button size="mini" class="primary-button" bindtap="saveCategoryEdit" loading="{{saving}}">保存分类</button></view>
  </view>

  <view class="fab-stack"><button class="assistant-fab" bindtap="openAssistant">✦ 问问助手</button><button class="fab" bindtap="openCreate"><text class="fab-plus">＋</text>记一笔</button></view>
  <ledger-switcher visible="{{switcherOpen}}" bindclose="closeLedgerSwitcher" />
  <tabbar current="accounting" />

  <view wx:if="{{formOpen}}" class="sheet"><view class="sheet-card"><view class="sheet-header"><button class="sheet-close" bindtap="closeForm">×</button><text class="sheet-title">{{editingId === null ? '记一笔' : '编辑交易'}}</text><text class="sheet-spacer"></text></view><view class="segmented"><button class="segment {{draft.type === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="handleTypeInput">支出</button><button class="segment {{draft.type === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="handleTypeInput">收入</button><button class="segment {{draft.type === 'transfer' ? 'is-active' : ''}}" data-type="transfer" bindtap="handleTypeInput">转账</button></view><view class="amount-input"><text>¥</text><input type="digit" value="{{draft.amount}}" placeholder="0.00" placeholder-class="amount-placeholder" data-field="amount" bindinput="handleDraftInput" focus="{{editingId === null}}"/></view><category-picker wx:if="{{draft.type !== 'transfer'}}" categories="{{draft.type === 'income' ? incomeCategories : expenseCategories}}" value="{{draft.categoryId}}" bindchange="handleCategoryInput"/><view wx:if="{{draft.type !== 'transfer'}}" class="quick-category"><input value="{{newCategoryName}}" maxlength="20" placeholder="输入新分类名称" bindinput="handleCategoryName"/><button bindtap="saveNewCategory" loading="{{saving}}" disabled="{{!newCategoryName}}">＋ 添加分类</button></view><picker mode="selector" range="{{accounts}}" range-key="name" bindchange="handleAccountInput"><view class="form-row"><text>账户</text><text>{{accountLabel}} ›</text></view></picker><picker wx:if="{{draft.type === 'transfer'}}" mode="selector" range="{{accounts}}" range-key="name" bindchange="handleToAccountInput"><view class="form-row"><text>转入账户</text><text>{{toAccountLabel}} ›</text></view></picker><view class="form-row"><text>日期</text><input type="date" value="{{draft.occurredOn}}" data-field="occurredOn" bindinput="handleDraftInput"/></view><view class="form-row"><text>备注</text><input value="{{draft.note}}" placeholder="添加备注" data-field="note" bindinput="handleDraftInput"/></view><text wx:if="{{errorMessage}}" class="state-error">{{errorMessage}}</text><button class="primary-button submit-button" bindtap="saveForm" loading="{{saving}}">保存</button></view></view>

  <view wx:if="{{selected}}" class="sheet"><view class="sheet-card detail-card"><view class="sheet-header"><button class="sheet-close" bindtap="closeDetail">×</button><text class="sheet-title">交易详情</text><text class="sheet-spacer"></text></view><text class="detail-title">{{selected.note || selected.categoryName || '未分类'}}</text><text class="transaction-meta">{{selected.occurredOn}} · {{selected.accountName || ''}}</text><text wx:if="{{selectedGenerated}}" class="hint">还款生成的交易只读，请到负债页修改还款。</text><view class="actions"><button bindtap="closeDetail">关闭</button><button wx:if="{{selectedCanEdit}}" class="primary-button" bindtap="openEdit">编辑</button><button wx:if="{{selectedCanDelete}}" class="danger-button" bindtap="requestDelete">删除</button></view></view></view>
  <confirm-dialog visible="{{confirmId !== null}}" title="删除交易" message="删除后会同步更新账户余额和统计。" loading="{{saving}}" bindconfirm="confirmDelete" bindcancel="cancelDelete"/>
</view>

<view class="page"><view class="header"><view><text class="title">交易</text><text class="sub">当前账本流水</text></view><button class="primary small" bindtap="openCreate">记一笔</button></view><view class="filters"><picker mode="date" fields="month" value="{{month}}" bindchange="handleMonthInput"><view class="filter">{{month}}</view></picker><picker mode="selector" range="{{['全部','支出','收入','转账']}}" bindchange="handleTypeFilter"><view class="filter">筛选类型</view></picker></view><view wx:if="{{loading}}" class="state">正在加载交易…</view><view wx:elif="{{errorMessage}}" class="state error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view><view wx:elif="{{!items.length}}" class="state">本月还没有交易</view><view wx:else class="list"><view wx:for="{{items}}" wx:key="id" class="row" data-id="{{item.id}}" bindtap="openDetail"><view><text class="row-title">{{item.note || item.categoryName || (item.sourceType === 'repayment' ? '还款' : '未分类')}}</text><text class="row-meta">{{item.occurredOn}} · {{item.accountName || ''}}{{item.toAccountName ? ' → ' + item.toAccountName : ''}}</text></view><text class="amount {{item.type}}">{{item.type === 'income' ? '+' : item.type === 'expense' ? '-' : ''}}¥{{item.amount}}</text></view></view><view wx:if="{{!loading && !errorMessage}}" class="section category-management"><text class="section-title">分类管理</text><text class="meta">支出分类</text><view wx:for="{{allExpenseCategories}}" wx:key="id" class="row"><text>{{item.name}}<text wx:if="{{item.archived}}" class="tag">已归档</text></text><view class="row-actions"><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="startCategoryEdit">改名</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleCategoryArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view><text class="meta">收入分类</text><view wx:for="{{allIncomeCategories}}" wx:key="id" class="row"><text>{{item.name}}<text wx:if="{{item.archived}}" class="tag">已归档</text></text><view class="row-actions"><button size="mini" wx:if="{{!item.archived}}" data-id="{{item.id}}" bindtap="startCategoryEdit">改名</button><button size="mini" wx:if="{{isOwner}}" data-id="{{item.id}}" data-archived="{{item.archived}}" bindtap="toggleCategoryArchive">{{item.archived ? '恢复' : '归档'}}</button></view></view><view wx:if="{{editingCategoryId !== null}}" class="category-edit"><input value="{{editingCategoryName}}" bindinput="handleCategoryEditName"/><button size="mini" class="primary" bindtap="saveCategoryEdit" loading="{{saving}}">保存分类</button></view></view><view wx:if="{{formOpen}}" class="sheet"><view class="sheet-card"><text class="sheet-title">{{editingId === null ? '记一笔' : '编辑交易'}}</text><picker mode="selector" range="{{['支出','收入','转账']}}" bindchange="handleTypeInput"><view class="field">类型：{{draft.type}}</view></picker><money-input value="{{draft.amount}}" label="金额" bindinput="handleDraftInput" data-field="amount"/><picker mode="selector" range="{{accounts}}" range-key="name" bindchange="handleAccountInput"><view class="field">记账账户：请选择</view></picker><picker wx:if="{{draft.type === 'transfer'}}" mode="selector" range="{{accounts}}" range-key="name" bindchange="handleToAccountInput"><view class="field">转入账户：请选择</view></picker><category-picker wx:if="{{draft.type !== 'transfer'}}" categories="{{draft.type === 'income' ? incomeCategories : expenseCategories}}" bindchange="handleCategoryInput"/><view wx:if="{{draft.type !== 'transfer'}}" class="category-create"><input value="{{newCategoryName}}" placeholder="新分类名称" bindinput="handleCategoryName"/><button size="mini" bindtap="saveNewCategory">新增分类</button></view><view class="field"><text>日期</text><input type="date" value="{{draft.occurredOn}}" data-field="occurredOn" bindinput="handleDraftInput"/></view><view class="field"><text>备注</text><input value="{{draft.note}}" placeholder="可选" data-field="note" bindinput="handleDraftInput"/></view><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><view class="actions"><button bindtap="closeForm" disabled="{{saving}}">取消</button><button class="primary" bindtap="saveForm" loading="{{saving}}">保存</button></view></view></view><view wx:if="{{selected}}" class="sheet"><view class="sheet-card"><text class="sheet-title">交易详情</text><text>{{selected.note || selected.categoryName || '未分类'}}</text><text wx:if="{{selectedGenerated}}" class="hint">还款生成的交易只读，请到负债页修改还款。</text><view class="actions"><button bindtap="closeDetail">关闭</button><button wx:if="{{selectedCanEdit}}" bindtap="openEdit">编辑</button><button wx:if="{{selectedCanDelete}}" class="danger" bindtap="requestDelete">删除</button></view></view></view><confirm-dialog visible="{{confirmId !== null}}" title="删除交易" message="删除后会同步更新账户余额和统计。" loading="{{saving}}" bindconfirm="confirmDelete" bindcancel="cancelDelete"/></view>

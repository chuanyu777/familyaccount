@import "../../styles/theme.wxss";
.invitation-page { min-height: 100vh; padding: 76rpx 36rpx; box-sizing: border-box; background: #f4f6f9; }
.invite-card { padding: 56rpx 38rpx 28rpx; border: 1rpx solid #dce1e9; border-radius: 16rpx; background: #fff; box-shadow: 0 10rpx 32rpx rgba(19,23,34,.06); text-align: center; }.token-card { padding-top: 44rpx; }
.avatars { display: flex; align-items: center; justify-content: center; margin-bottom: 42rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; color: #fff; font-weight: 700; }.avatar--blue { background: #3159d7; }.avatar--green { background: #19765d; }.link-mark { width: 76rpx; color: #697080; font-size: 40rpx; transform: rotate(-25deg); }
.page-title { display: block; font-size: 39rpx; font-weight: 750; }.hint { display: block; margin-top: 18rpx; color: #697080; font-size: 24rpx; }.inviter { color: #151820; font-weight: 700; }
.invite-meta { margin: 46rpx 0 34rpx; border-top: 1rpx solid #dce1e9; border-bottom: 1rpx solid #dce1e9; }.invite-meta view { display: flex; justify-content: space-between; padding: 21rpx 0; font-size: 23rpx; }.invite-meta view + view { border-top: 1rpx solid #dce1e9; }.invite-meta text:first-child { color: #697080; }.invite-meta text:last-child { font-weight: 650; }
.token-icon { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto 32rpx; border-radius: 18rpx; background: #e6ebfb; color: #3159d7; font-size: 56rpx; transform: rotate(-20deg); }.token-input { height: 88rpx; margin-top: 40rpx; padding: 0 22rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #f4f6f9; text-align: left; }
.accept-button { height: 88rpx; margin-top: 30rpx; border-radius: 14rpx; background: #3159d7; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 88rpx; }.decline-button { margin-top: 12rpx; padding: 14rpx; background: transparent; color: #697080; font-size: 23rpx; line-height: 1.5; }.error-message { display: block; margin-top: 22rpx; color: #b84543; text-align: center; }
.security-hint { display: flex; justify-content: center; gap: 10rpx; margin-top: 28rpx; color: #697080; font-size: 21rpx; }.shield { display: inline-flex; align-items: center; justify-content: center; width: 26rpx; height: 26rpx; border: 2rpx solid #19765d; border-radius: 50%; color: #19765d; font-size: 16rpx; }

<view class="screen-page liabilities-page">
  <view class="ledger-head"><button class="ledger-selector" bindtap="openLedgerSwitcher">{{ledgerName}} <text class="chevron">⌄</text></button><button class="header-action" bindtap="openCreate">＋</button></view>
  <view wx:if="{{loading}}" class="empty-state">正在加载负债…</view>
  <view wx:elif="{{errorMessage}}" class="empty-state state-error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view>
  <block wx:else>
    <view class="debt-overview"><view><text>待还总额</text><strong>¥ {{totalRemaining}}</strong></view><view><text>月供</text><b>¥ {{totalMonthly}}</b></view></view>
    <view class="content-section"><view class="section-title"><text>我的负债</text><text class="section-title__meta">{{liabilities.length}} 项</text></view><view class="debt-list"><view wx:for="{{liabilities}}" wx:key="id" class="debt-row" data-id="{{item.id}}" bindtap="selectLiability"><view class="debt-mark {{item.archived ? 'muted-mark' : (index % 2 ? 'red-mark' : '')}}">{{index % 2 ? '¥' : '⌂'}}</view><view class="debt-body"><text class="debt-name">{{item.name}}</text><text class="debt-meta">每月 ¥{{item.monthlyPayment}}{{item.paymentDay ? ' · ' + item.paymentDay + '日还款' : ''}}</text><view class="progress"><view class="progress-value"></view></view></view><view class="debt-amount"><text>¥{{item.remaining}}</text><button size="mini" data-id="{{item.id}}" bindtap="openRepayment">还款</button></view></view><view wx:if="{{!liabilities.length}}" class="empty-inline">暂无负债</view></view></view>
    <view class="content-section"><view class="section-title"><text>最近还款</text><text class="section-title__meta">{{repayments.length}} 笔</text></view><view wx:for="{{repayments}}" wx:key="id" class="repayment-row"><view class="repayment-mark">✓</view><view class="repayment-body"><text>还款</text><text class="repayment-meta">{{item.occurred_on}}</text></view><text class="repayment-value">- ¥{{item.amount}}</text><button size="mini" wx:if="{{item.canEdit}}" data-id="{{item.id}}" bindtap="editRepayment">编辑</button></view><view wx:if="{{!repayments.length}}" class="empty-inline">暂无还款记录</view></view>
    <button class="fab fab--debt" bindtap="openCreate"><text>＋</text>新增负债</button>
  </block>
  <ledger-switcher visible="{{switcherOpen}}" bindclose="closeLedgerSwitcher" />
  <tabbar current="liabilities" />
  <view wx:if="{{form}}" class="sheet"><view class="sheet-card"><view class="sheet-header"><button class="sheet-close" bindtap="closeForm">×</button><text class="sheet-title">{{form === 'liability' ? (editingId === null ? '新增负债' : '编辑负债') : (editingId === null ? '还一笔' : '编辑还款')}}</text><text class="sheet-spacer"></text></view><view wx:if="{{form === 'liability'}}"><view class="form-row"><text>名称</text><input value="{{name}}" data-field="name" bindinput="handleInput"/></view><money-input value="{{remaining}}" label="剩余本金" bindinput="handleInput" data-field="remaining"/><money-input value="{{monthlyPayment}}" label="每月还款额" bindinput="handleInput" data-field="monthlyPayment"/><view class="form-row"><text>还款日</text><input type="number" value="{{paymentDay}}" data-field="paymentDay" bindinput="handleInput"/></view></view><view wx:else><money-input value="{{amount}}" label="还款金额" bindinput="handleInput" data-field="amount"/><view class="form-row"><text>还款日期</text><input type="date" value="{{occurredOn}}" data-field="occurredOn" bindinput="handleInput"/></view><picker mode="selector" range="{{accounts}}" range-key="name" bindchange="handleAccount"><view class="form-row"><text>还款账户</text><text>{{accountLabel}} ›</text></view></picker></view><text wx:if="{{errorMessage}}" class="state-error">{{errorMessage}}</text><view class="actions"><button bindtap="closeForm">取消</button><button class="primary-button" bindtap="saveForm" loading="{{saving}}">保存</button></view></view></view>
  <confirm-dialog visible="{{confirmId !== null}}" title="删除还款" message="删除后会恢复负债本金和账户余额。" loading="{{saving}}" bindconfirm="confirmDelete" bindcancel="cancelDelete"/>
</view>

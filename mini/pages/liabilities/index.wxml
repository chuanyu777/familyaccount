<view class="page"><view class="header"><text class="title">负债</text><button class="primary" bindtap="openCreate">新增负债</button></view><view wx:if="{{loading}}" class="state">正在加载负债…</view><view wx:elif="{{errorMessage}}" class="state error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view><view wx:elif="{{!liabilities.length}}" class="state">暂无负债</view><view wx:else><view wx:for="{{liabilities}}" wx:key="id" class="section"><view class="liability-head" data-id="{{item.id}}" bindtap="selectLiability"><view><text class="name">{{item.name}} <text wx:if="{{item.archived}}" class="tag">已归档</text></text><text class="meta">剩余本金 ¥{{item.remaining}} · 月供 ¥{{item.monthlyPayment}}{{item.paymentDay ? ' · 每月 ' + item.paymentDay + ' 日' : ''}}</text></view><view class="row-actions"><button size="mini" bindtap="openEdit" data-id="{{item.id}}">编辑</button><button size="mini" wx:if="{{!item.archived}}" bindtap="openRepayment" data-id="{{item.id}}">还一笔</button><button size="mini" wx:if="{{isOwner}}" bindtap="toggleArchive" data-id="{{item.id}}" data-archived="{{item.archived}}">{{item.archived ? '恢复' : '归档'}}</button></view></view><view wx:if="{{selectedId === item.id}}" class="repayments"><view wx:for="{{repayments}}" wx:key="id" wx:if="{{item.liability_id === selectedId}}" class="repayment"><text>{{item.occurred_on}} · ¥{{item.amount}}</text><view wx:if="{{item.canEdit}}"><button size="mini" bindtap="editRepayment" data-id="{{item.id}}">编辑</button><button size="mini" class="danger" bindtap="requestDeleteRepayment" data-id="{{item.id}}">删除</button></view></view><text class="hint">生成的交易只读，请在负债页修改还款。</text></view></view></view><view wx:if="{{form}}" class="sheet"><view class="sheet-card"><text class="sheet-title">{{form === 'liability' ? (editingId === null ? '新增负债' : '编辑负债') : (editingId === null ? '还一笔' : '编辑还款')}}</text><view wx:if="{{form === 'liability'}}"><view class="field"><text>名称</text><input value="{{name}}" data-field="name" bindinput="handleInput"/></view><money-input value="{{remaining}}" label="剩余本金" bindinput="handleInput" data-field="remaining"/><money-input value="{{monthlyPayment}}" label="每月还款额" bindinput="handleInput" data-field="monthlyPayment"/><view class="field"><text>还款日</text><input type="number" value="{{paymentDay}}" data-field="paymentDay" bindinput="handleInput"/></view></view><view wx:else><money-input value="{{amount}}" label="还款金额" bindinput="handleInput" data-field="amount"/><view class="field"><text>还款日期</text><input type="date" value="{{occurredOn}}" data-field="occurredOn" bindinput="handleInput"/></view><picker mode="selector" range="{{accounts}}" range-key="name" bindchange="handleAccount"><view class="field">还款账户：请选择</view></picker></view><text wx:if="{{errorMessage}}" class="error">{{errorMessage}}</text><view class="actions"><button bindtap="closeForm" disabled="{{saving}}">取消</button><button class="primary" bindtap="saveForm" loading="{{saving}}">保存</button></view></view></view><confirm-dialog visible="{{confirmId !== null}}" title="删除还款" message="删除后会恢复负债本金和账户余额。" loading="{{saving}}" bindconfirm="confirmDelete" bindcancel="cancelDelete"/></view>

.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.title { font-size: 42rpx; font-weight: 600; }.primary { margin: 0; color: #fff; background: #2563eb; border-radius: 8rpx; }.section { margin-bottom: 20rpx; padding: 24rpx; background: #fff; border-radius: 8rpx; }.liability-head, .repayment { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; }.name { font-size: 30rpx; }.meta, .hint, .state { display: block; color: #6b7280; font-size: 24rpx; margin-top: 8rpx; }.row-actions { display: flex; gap: 8rpx; flex-wrap: wrap; justify-content: flex-end; }.tag { color: #b45309; font-size: 22rpx; }.repayments { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #eef0f2; }.repayment { min-height: 70rpx; border-bottom: 1rpx solid #f2f3f5; }.repayment button { display: inline-block; margin-left: 8rpx; }.state { padding: 70rpx 20rpx; text-align: center; }.error { color: #b91c1c; }.sheet { position: fixed; z-index: 5; inset: 0; display: flex; align-items: flex-end; background: rgba(15,23,42,.35); }.sheet-card { width: 100%; padding: 34rpx 28rpx 50rpx; background: #f7f8fa; border-radius: 24rpx 24rpx 0 0; box-sizing: border-box; }.sheet-title { display: block; margin-bottom: 22rpx; font-size: 36rpx; font-weight: 600; }.field { display: flex; align-items: center; justify-content: space-between; min-height: 78rpx; margin-bottom: 20rpx; padding: 0 22rpx; background: #fff; border: 1rpx solid #d7dce2; border-radius: 8rpx; box-sizing: border-box; }.field input { flex: 1; min-width: 0; text-align: right; }.actions { display: flex; gap: 16rpx; margin-top: 26rpx; }.actions button { flex: 1; border-radius: 8rpx; }.danger { color: #fff; background: #dc2626; }

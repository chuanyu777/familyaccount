@import "../../styles/theme.wxss";
.assistant-page { min-height: 100vh; display: flex; flex-direction: column; background: #f4f6f9; }.assistant-context { display: flex; align-items: center; gap: 12rpx; margin: 18rpx 28rpx 0; padding: 16rpx 18rpx; border-radius: 14rpx; color: #3159d7; background: #e6ebfb; font-size: 22rpx; }.assistant-context text:nth-child(2) { flex: 1; }.assistant-chat { flex: 1; box-sizing: border-box; padding: 32rpx 28rpx; }.assistant-welcome { display: flex; align-items: center; gap: 18rpx; }.assistant-logo { display: grid; width: 76rpx; height: 76rpx; place-items: center; border-radius: 20rpx; color: #fff; background: #3159d7; font-size: 34rpx; }.assistant-title, .assistant-subtitle { display: block; }.assistant-title { font-size: 28rpx; font-weight: 700; }.assistant-subtitle { margin-top: 5rpx; color: #697080; font-size: 21rpx; }.assistant-quick { display: flex; gap: 10rpx; margin: 22rpx 0 28rpx; }.assistant-quick button { flex: 1; margin: 0; padding: 0 8rpx; border: 1rpx solid #dce1e9; border-radius: 12rpx; color: #3159d7; background: #fff; font-size: 20rpx; }.message { max-width: 82%; margin: 16rpx 0; padding: 17rpx 20rpx; border-radius: 16rpx 16rpx 16rpx 4rpx; color: #131722; background: #e6ebfb; font-size: 24rpx; line-height: 1.55; }.message-user { margin-left: auto; border-radius: 16rpx 16rpx 4rpx 16rpx; color: #fff; background: #3159d7; }.error { display: block; color: #b84543; font-size: 22rpx; }.assistant-composer { display: grid; grid-template-columns: 64rpx 1fr 64rpx; gap: 12rpx; align-items: center; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dce1e9; background: #fff; }.assistant-composer input { height: 72rpx; padding: 0 18rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #f4f6f9; box-sizing: border-box; font-size: 24rpx; }.attach, .send { width: 58rpx; height: 58rpx; margin: 0; padding: 0; border-radius: 50%; line-height: 58rpx; }.attach { color: #697080; background: #f4f6f9; }.send { color: #fff; background: #3159d7; }

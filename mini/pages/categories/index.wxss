@import "../../styles/theme.wxss";
.category-page { min-height: 100vh; padding: 34rpx 32rpx 60rpx; box-sizing: border-box; background: #f4f6f9; }.page-head { display: flex; align-items: center; justify-content: space-between; }.page-head > view { display: flex; flex-direction: column; }.page-title { font-size: 40rpx; font-weight: 750; }.page-subtitle { margin-top: 4rpx; color: #8a92a1; font-size: 21rpx; }.add-button { margin: 0; padding: 9rpx 18rpx; border-radius: 11rpx; color: #3159d7; background: #e9efff; font-size: 22rpx; line-height: 1.5; }.segmented { display: flex; gap: 4rpx; margin-top: 30rpx; padding: 5rpx; border-radius: 12rpx; background: #e9edf3; }.segment { flex: 1; height: 62rpx; margin: 0; padding: 0; border-radius: 9rpx; color: #8a92a1; background: transparent; font-size: 23rpx; line-height: 62rpx; }.segment.is-active { color: #151820; background: #fff; box-shadow: 0 2rpx 8rpx rgba(19,23,34,.08); font-weight: 700; }.category-list { margin-top: 24rpx; overflow: hidden; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.category-row { display: grid; grid-template-columns: 62rpx 1fr auto auto; align-items: center; gap: 12rpx; min-height: 100rpx; padding: 0 18rpx; border-bottom: 1rpx solid #eef1f5; }.category-row:last-child { border-bottom: 0; }.category-row.is-archived { opacity: .58; }.category-mark { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 13rpx; color: #b84543; background: #f8e9e8; font-size: 32rpx; font-weight: 700; }.category-mark.income { color: #19765d; background: #e4f1ed; }.category-copy { display: flex; min-width: 0; flex-direction: column; }.category-copy > text:first-child { font-size: 25rpx; font-weight: 700; }.category-copy > text:last-child { margin-top: 3rpx; color: #8a92a1; font-size: 18rpx; }.row-action { margin: 0; padding: 5rpx 10rpx; color: #3159d7; background: transparent; font-size: 19rpx; line-height: 1.5; }.row-action.archive { color: #b84543; }.row-action.restore { color: #19765d; }.permission-hint { display: block; margin-top: 18rpx; color: #8a92a1; font-size: 20rpx; line-height: 1.55; }.state-error { display: block; margin-top: 18rpx; }.sheet-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }.editor-sheet { position: relative; width: 100%; padding: 26rpx 36rpx calc(42rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; box-sizing: border-box; }.sheet-head { display: grid; grid-template-columns: 90rpx 1fr 90rpx; align-items: center; margin-bottom: 28rpx; }.sheet-head button { margin: 0; padding: 0; color: #697080; background: transparent; font-size: 23rpx; }.sheet-head text { font-size: 29rpx; font-weight: 700; text-align: center; }.sheet-head .save { color: #3159d7; }.editor-sheet > input { height: 86rpx; padding: 0 24rpx; border: 1rpx solid #dce1e9; border-radius: 13rpx; background: #f7f8fa; box-sizing: border-box; font-size: 27rpx; }.count { display: block; margin-top: 8rpx; color: #9aa1ad; font-size: 19rpx; text-align: right; }

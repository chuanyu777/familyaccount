<view class="settings-page"><view wx:if="{{loading}}" class="state-message">正在加载设置...</view><view wx:elif="{{errorMessage}}" class="state-message error-message">{{errorMessage}}</view><block wx:elif="{{ledger}}"><view class="settings-header"><text class="page-title">账本设置</text><text class="ledger-name">{{ledger.name}}</text></view><view class="section"><text class="section-title">成员</text><view wx:for="{{members}}" wx:key="id" class="member-row"><view><text class="member-name">{{item.displayName}}</text><text class="member-role">{{item.role === 'OWNER' ? '所有者' : '成员'}} · {{item.active ? '正常' : '已停用'}}</text></view><button wx:if="{{ledger.role === 'OWNER' && item.role !== 'OWNER' && item.active}}" class="danger-button" data-member="{{item}}" bindtap="handleRemove">移除</button></view><button wx:if="{{ledger.role === 'OWNER'}}" class="primary-button" bindtap="handleInvite">生成邀请</button><view wx:if="{{invitation}}" class="invitation"><text>邀请令牌</text><text class="token">{{invitation.token}}</text></view></view><view class="section" wx:if="{{ledger.role === 'OWNER'}}"><text class="section-title">账本名称</text><input value="{{nameDraft}}" bindinput="handleNameInput" /><button class="primary-button" bindtap="handleRename">保存名称</button></view><view class="section"><text class="section-title">共享资源</text><button class="link-button" data-tab="accounting" bindtap="handleSharedEdit">编辑账目</button><button class="link-button" data-tab="assets" bindtap="handleSharedEdit">编辑资产</button><button class="link-button" data-tab="liabilities" bindtap="handleSharedEdit">编辑负债</button><button wx:if="{{ledger.role === 'OWNER'}}" class="link-button" disabled>归档 / 恢复资源</button></view><button wx:if="{{ledger.role !== 'OWNER'}}" class="leave-button" bindtap="handleLeave">离开账本</button><button class="link-button" bindtap="handleBindWeb">绑定 Web 账号</button></block></view>

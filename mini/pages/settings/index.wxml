<view class="screen-page settings-page">
  <view wx:if="{{loading}}" class="empty-state">正在加载设置…</view>
  <view wx:elif="{{errorMessage && !ledger}}" class="empty-state state-error">{{errorMessage}}</view>
  <block wx:elif="{{ledger}}">
    <view class="ledger-head"><button class="ledger-selector" bindtap="openLedgerSwitcher">{{ledger.name}} <text class="chevron">⌄</text></button><text class="role-pill">{{ledger.role === 'OWNER' ? '所有者' : '成员'}}</text></view>

    <view class="profile-card">
      <button class="profile-avatar" open-type="chooseAvatar" bindchooseavatar="handleChooseAvatar" loading="{{profileSaving}}"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"/><text wx:else>{{profileInitial}}</text></button>
      <view class="profile-copy"><text class="profile-label">我的资料</text><input type="nickname" value="{{profileName}}" maxlength="50" placeholder="填写昵称" bindinput="handleProfileName"/></view>
      <button class="save-profile" bindtap="saveProfileName" loading="{{profileSaving}}">保存</button>
    </view>
    <text class="profile-hint">点击头像可从微信头像中选择，昵称由你确认后保存</text>

    <view class="members-section"><view class="section-title"><text>家庭成员</text><button wx:if="{{ledger.role === 'OWNER'}}" class="inline-action" bindtap="handleInvite">＋ 邀请</button></view><view class="member-list"><view wx:for="{{members}}" wx:key="id" class="member-row"><view class="avatar avatar-{{index % 3}}">{{item.initial}}</view><view class="member-body"><text class="member-name">{{item.displayName}} <text wx:if="{{item.isMe}}" class="me">我</text></text><text class="member-subtitle">{{item.role === 'OWNER' ? '账本创建者' : '家庭成员'}} · {{item.active ? '正常' : '已停用'}}</text></view><text class="member-badge {{item.role === 'OWNER' ? '' : 'member-badge--plain'}}">{{item.role === 'OWNER' ? '管理员' : '成员'}}</text><button wx:if="{{ledger.role === 'OWNER' && item.role !== 'OWNER' && item.active}}" class="danger-link" data-member="{{item}}" bindtap="handleRemove">移除</button></view></view></view>

    <view class="settings-group"><text class="group-title">账本设置</text><view wx:if="{{ledger.role === 'OWNER'}}" class="setting-row" bindtap="openRename"><view class="row-label"><text class="setting-icon">✎</text><text>账本名称</text></view><view class="row-value"><text>{{ledger.name}}</text><text class="arrow">›</text></view></view><view class="setting-row" bindtap="openCategoryManagement"><view class="row-label"><text class="setting-icon">⌗</text><text>分类管理</text></view><view class="row-value"><text>支出、收入自定义分类</text><text class="arrow">›</text></view></view></view>
    <view class="settings-group"><text class="group-title">账号与数据</text><view class="setting-row" bindtap="openWebLedgerImport"><view class="row-label"><text class="setting-icon">⌁</text><text>导入已有账本</text></view><view class="row-value"><text>使用 Web 端绑定码</text><text class="arrow">›</text></view></view></view>
    <view wx:if="{{ledger.role !== 'OWNER'}}" class="settings-group"><text class="group-title">账本操作</text><button class="danger-button" bindtap="handleLeave">离开账本</button></view>
    <text wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</text>

    <view wx:if="{{renameOpen}}" class="sheet-mask" bindtap="closeRename"><view class="rename-sheet" catchtap="noop"><view class="rename-head"><button bindtap="closeRename">取消</button><text>修改账本名称</text><button class="rename-save" bindtap="handleRename">保存</button></view><input value="{{nameDraft}}" maxlength="20" focus="{{renameOpen}}" placeholder="请输入账本名称" bindinput="handleNameInput"/><text class="rename-count">{{nameDraft.length}}/20</text></view></view>
    <view wx:if="{{invitation}}" class="share-mask"><view class="share-sheet"><view class="share-visual">⌁</view><text class="share-title">邀请家人一起记账</text><text class="share-copy">邀请有效期为 7 天，每个邀请仅可使用一次</text><button open-type="share" class="primary-button">发送给微信好友</button><text class="token">邀请口令：{{invitation.token}}</text></view></view>
  </block>
  <ledger-switcher visible="{{switcherOpen}}" bindclose="closeLedgerSwitcher"/>
  <tabbar current="settings"/>
</view>

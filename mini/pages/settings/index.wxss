.settings-page { min-height: 100vh; padding: 40rpx; box-sizing: border-box; background: #f7f8fa; color: #1f2937; }.settings-header { padding-bottom: 28rpx; border-bottom: 1rpx solid #e5e7eb; }.page-title { display: block; font-size: 44rpx; font-weight: 600; }.ledger-name { display: block; margin-top: 10rpx; color: #6b7280; }.section { margin-top: 28rpx; padding: 28rpx; background: #fff; border: 1rpx solid #e5e7eb; border-radius: 8rpx; }.section-title { display: block; margin-bottom: 20rpx; font-size: 30rpx; font-weight: 600; }.member-row { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f1f3; }.member-name, .member-role { display: block; }.member-role { margin-top: 8rpx; color: #6b7280; font-size: 24rpx; }.primary-button, .danger-button, .leave-button, .link-button { margin: 20rpx 0 0; border-radius: 8rpx; font-size: 26rpx; }.primary-button { color: #fff; background: #2563eb; }.danger-button, .leave-button { color: #dc2626; background: #fff; }.link-button { color: #2563eb; background: #eff6ff; }.section input { height: 76rpx; padding: 0 18rpx; margin-bottom: 8rpx; border: 1rpx solid #d1d5db; border-radius: 8rpx; }.invitation { margin-top: 20rpx; padding: 18rpx; background: #eff6ff; }.token { display: block; margin-top: 10rpx; word-break: break-all; }.state-message { display: block; padding: 160rpx 20rpx; text-align: center; color: #6b7280; }.error-message { color: #dc2626; }

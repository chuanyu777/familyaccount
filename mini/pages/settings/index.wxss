@import "../../styles/theme.wxss";
.profile-card { display: grid; grid-template-columns: 82rpx 1fr auto; align-items: center; gap: 18rpx; margin-top: 28rpx; padding: 22rpx 20rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.profile-avatar { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; margin: 0; padding: 0; overflow: hidden; border-radius: 50%; color: #fff; background: #3159d7; font-size: 28rpx; font-weight: 700; line-height: 78rpx; }.profile-avatar image { width: 100%; height: 100%; }.profile-copy { display: flex; min-width: 0; flex-direction: column; }.profile-label { color: #8a92a1; font-size: 19rpx; }.profile-copy input { height: 48rpx; margin-top: 4rpx; color: #151820; font-size: 27rpx; font-weight: 700; }.save-profile { margin: 0; padding: 7rpx 14rpx; color: #3159d7; background: #eef2ff; border-radius: 10rpx; font-size: 20rpx; line-height: 1.5; }.profile-hint { display: block; margin: 10rpx 4rpx 0; color: #9299a6; font-size: 19rpx; line-height: 1.5; }
.role-pill { padding: 8rpx 16rpx; border-radius: 20rpx; color: #3159d7; background: #e9efff; font-size: 21rpx; }.members-section { margin-top: 28rpx; }.inline-action { margin: 0; padding: 5rpx 14rpx; color: #3159d7; background: transparent; font-size: 21rpx; line-height: 1.4; }.member-list { overflow: hidden; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.member-row { display: grid; grid-template-columns: 72rpx 1fr auto auto; align-items: center; gap: 14rpx; min-height: 112rpx; padding: 0 18rpx; border-bottom: 1rpx solid #eef1f5; }.member-row:last-child { border-bottom: 0; }.avatar { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; overflow: hidden; border-radius: 50%; color: #fff; background: #3159d7; font-size: 21rpx; font-weight: 700; white-space: nowrap; }.avatar-1 { background: #19765d; }.avatar-2 { background: #a85c75; }.member-body { display: flex; min-width: 0; flex-direction: column; }.member-name { font-size: 24rpx; font-weight: 700; }.me { color: #697080; font-size: 18rpx; font-weight: 400; }.member-subtitle { margin-top: 4rpx; color: #8a92a1; font-size: 19rpx; }.member-badge { color: #b47b18; font-size: 19rpx; font-weight: 700; }.member-badge--plain { color: #697080; }.danger-link { margin: 0; padding: 0 8rpx; color: #b84543; background: transparent; font-size: 19rpx; }.settings-group { margin-top: 34rpx; overflow: hidden; border-radius: 14rpx; }.group-title { display: block; margin: 0 4rpx 12rpx; color: #8a92a1; font-size: 21rpx; }.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; padding: 0 20rpx; border-bottom: 1rpx solid #e3e8ef; background: #fff; }.row-label { display: flex; align-items: center; gap: 16rpx; }.row-value { display: flex; min-width: 0; align-items: center; gap: 12rpx; color: #8a92a1; font-size: 20rpx; }.setting-icon { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 10rpx; color: #3159d7; background: #e6ebfb; font-size: 23rpx; }.arrow { color: #a2a8b3; font-size: 34rpx; }.danger-button { width: 100%; margin: 0; color: #b84543; background: #fff; border: 1rpx solid #f0c9c7; border-radius: 12rpx; }.inline-error { display: block; margin-top: 18rpx; color: #b84543; font-size: 21rpx; text-align: center; }.sheet-mask, .share-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }.rename-sheet { position: relative; width: 100%; padding: 26rpx 36rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: #fff; }.rename-head { display: grid; grid-template-columns: 90rpx 1fr 90rpx; align-items: center; margin-bottom: 28rpx; }.rename-head button { margin: 0; padding: 0; color: #697080; background: transparent; font-size: 23rpx; }.rename-head text { font-size: 29rpx; font-weight: 700; text-align: center; }.rename-head .rename-save { color: #3159d7; }.rename-sheet > input { height: 86rpx; padding: 0 24rpx; border: 1rpx solid #dce1e9; border-radius: 13rpx; background: #f7f8fa; box-sizing: border-box; font-size: 27rpx; }.rename-count { display: block; margin-top: 8rpx; color: #9aa1ad; font-size: 19rpx; text-align: right; }.share-sheet { width: 100%; padding: 40rpx 36rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: #fff; text-align: center; }.share-visual { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #e6ebfb; color: #3159d7; font-size: 74rpx; transform: rotate(-22deg); }.share-title { display: block; font-size: 36rpx; font-weight: 750; }.share-copy { display: block; margin-top: 10rpx; color: #697080; font-size: 22rpx; }.primary-button { height: 88rpx; margin-top: 36rpx; border-radius: 14rpx; color: #fff; background: #3159d7; font-weight: 700; line-height: 88rpx; }.token { display: block; margin-top: 18rpx; color: #9aa1ad; font-size: 19rpx; word-break: break-all; }

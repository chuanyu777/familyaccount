.ledger-page { min-height: 100vh; padding: 48rpx; box-sizing: border-box; background: #f7f8fa; }
.page-header, .ledger-item, .ledger-info, .ledger-actions { display: flex; align-items: center; }
.page-header { justify-content: space-between; margin-bottom: 32rpx; }.page-title { font-size: 44rpx; font-weight: 600; }
.create-button, .switch-button, .leave-button, .invite-button, .share-button { margin: 0; border-radius: 8rpx; font-size: 26rpx; }
.create-button, .invite-button, .share-button { background: #2563eb; color: #fff; }.ledger-item { justify-content: space-between; padding: 32rpx 0; border-bottom: 1rpx solid #e5e7eb; background: #fff; }
.ledger-info { flex-direction: column; align-items: flex-start; gap: 10rpx; }.ledger-name { font-size: 32rpx; }.ledger-role, .current-label, .state-message { color: #6b7280; }.ledger-actions { gap: 12rpx; }.leave-button { color: #dc2626; background: #fff; }.error-message { display: block; margin-bottom: 24rpx; color: #dc2626; }.invitation-result { margin-top: 40rpx; padding: 28rpx; background: #fff; border-radius: 8rpx; }.token { display: block; margin: 18rpx 0; word-break: break-all; color: #374151; }

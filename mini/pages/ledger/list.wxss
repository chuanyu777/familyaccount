@import "../../styles/theme.wxss";
.ledger-page { min-height: 100vh; padding: 48rpx 36rpx; box-sizing: border-box; background: #f4f6f9; }.page-header { margin-bottom: 34rpx; }.page-header > view { display: flex; flex-direction: column; }.page-title { font-size: 43rpx; font-weight: 750; }.page-subtitle { margin-top: 8rpx; color: #697080; font-size: 23rpx; }
.ledger-item { margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.ledger-choice { display: grid; grid-template-columns: 82rpx 1fr 40rpx; align-items: center; gap: 18rpx; width: 100%; min-height: 120rpx; margin: 0; padding: 14rpx 18rpx; background: transparent; text-align: left; line-height: 1.4; }.ledger-mark { display: flex; align-items: center; justify-content: center; width: 78rpx; height: 78rpx; border-radius: 14rpx; }.ledger-mark view { width: 34rpx; height: 42rpx; border: 4rpx solid currentColor; border-radius: 4rpx; }.blue { color: #3159d7; background: #e6ebfb; }.green { color: #19765d; background: #e4f1ed; }.gold { color: #b47b18; background: #f7efdc; }.ledger-info { display: flex; flex-direction: column; }.ledger-name { font-size: 28rpx; font-weight: 700; }.ledger-role { margin-top: 3rpx; color: #697080; font-size: 21rpx; }.selected { color: #3159d7; font-size: 30rpx; font-weight: 700; }.arrow { color: #a2a8b3; font-size: 42rpx; }
.ledger-actions { display: flex; justify-content: flex-end; gap: 10rpx; padding: 0 16rpx 14rpx; }.leave-button,.invite-button,.current-entry { min-width: 128rpx; height: 52rpx; margin: 0; padding: 0 18rpx; border-radius: 10rpx; background: #f4f6f9; font-size: 21rpx; line-height: 52rpx; }.leave-button { color: #b84543; }.invite-button,.current-entry { color: #3159d7; background: #e6ebfb; }
.create-button { display: flex; align-items: center; justify-content: flex-start; gap: 14rpx; width: 100%; height: 82rpx; margin-top: 10rpx; padding: 0 8rpx; background: transparent; color: #3159d7; font-size: 25rpx; line-height: 82rpx; }.create-button text { font-size: 34rpx; }.state-message,.error-message { display: block; margin: 20rpx 0; text-align: center; }.state-message { color: #697080; }.error-message { color: #b84543; }
.share-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: flex-end; background: rgba(19,23,34,.38); }.invitation-result { width: 100%; padding: 40rpx 36rpx calc(42rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 34rpx 34rpx 0 0; background: #fff; text-align: center; }.share-visual { display: flex; align-items: center; justify-content: center; width: 150rpx; height: 150rpx; margin: 0 auto 28rpx; border-radius: 50%; background: #e6ebfb; color: #3159d7; font-size: 74rpx; transform: rotate(-22deg); }.share-title { display: block; font-size: 36rpx; font-weight: 750; }.share-copy { display: block; margin-top: 10rpx; color: #697080; font-size: 22rpx; }.share-button { height: 88rpx; margin-top: 38rpx; border-radius: 14rpx; background: #3159d7; color: #fff; font-size: 27rpx; font-weight: 700; line-height: 88rpx; }.token { display: block; margin-top: 18rpx; color: #9aa1ad; font-size: 19rpx; word-break: break-all; }

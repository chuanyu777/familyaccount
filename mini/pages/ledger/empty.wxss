@import "../../styles/theme.wxss";
.empty-page { min-height: 100vh; padding: 120rpx 48rpx 70rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; background: #f4f6f9; }
.empty-visual { position: relative; width: 300rpx; height: 260rpx; }
.empty-book { position: absolute; left: 79rpx; top: 30rpx; width: 142rpx; height: 166rpx; padding: 48rpx 28rpx; box-sizing: border-box; border-radius: 14rpx; background: #e6ebfb; transform: rotate(-3deg); }
.empty-book__binding { position: absolute; left: 18rpx; top: -10rpx; width: 10rpx; height: 182rpx; border-radius: 5rpx; background: #3159d7; }
.empty-book > view:not(.empty-book__binding) { height: 8rpx; margin-top: 17rpx; border-radius: 4rpx; background: #3159d7; opacity: .62; }
.person { position: absolute; bottom: 17rpx; width: 84rpx; height: 80rpx; border-radius: 42rpx 42rpx 12rpx 12rpx; }
.person::before { content: ""; position: absolute; left: 24rpx; top: -36rpx; width: 42rpx; height: 42rpx; border-radius: 50%; }
.person--one { left: 30rpx; background: #3159d7; }.person--one::before { background: #3159d7; }
.person--two { right: 25rpx; width: 70rpx; height: 68rpx; background: #19765d; }.person--two::before { left: 17rpx; background: #19765d; }
.empty-copy { display: flex; flex-direction: column; align-items: center; }
.empty-title { font-size: 43rpx; font-weight: 750; }
.empty-hint { max-width: 540rpx; margin-top: 20rpx; color: #697080; text-align: center; }
.button-stack { width: 100%; margin-top: 70rpx; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; height: 92rpx; border-radius: 14rpx; font-size: 28rpx; font-weight: 700; line-height: 92rpx; }
.primary-button { background: #3159d7; color: #fff; }
.secondary-button { margin-top: 20rpx; color: #3159d7; background: #fff; border: 1rpx solid #cbd6f6; }
.import-link { margin-top: 26rpx; border: 0; background: transparent; color: #7b8494; font-size: 24rpx; }
.button-icon { font-size: 34rpx; font-weight: 400; }.link-icon { font-size: 38rpx; transform: rotate(-25deg); }

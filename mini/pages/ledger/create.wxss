@import "../../styles/theme.wxss";
.create-page { min-height: 100vh; padding: 70rpx 36rpx; box-sizing: border-box; background: #f4f6f9; }
.form-intro { display: flex; flex-direction: column; }.page-title { font-size: 44rpx; font-weight: 750; }.page-subtitle { margin-top: 16rpx; color: #697080; font-size: 25rpx; }
.field { display: block; margin-top: 72rpx; }.field-label { display: block; margin: 0 0 13rpx 3rpx; color: #555d6c; font-size: 24rpx; font-weight: 650; }
.input-wrap { position: relative; }.name-input { height: 96rpx; padding: 0 100rpx 0 24rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; font-size: 29rpx; }.counter { position: absolute; right: 24rpx; bottom: 31rpx; color: #9ba1ac; font-size: 20rpx; }
.setup-note { display: flex; gap: 18rpx; margin-top: 34rpx; padding: 24rpx; border-radius: 14rpx; background: #e4f1ed; }.check { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; border: 3rpx solid #19765d; border-radius: 50%; color: #19765d; font-size: 21rpx; font-weight: 750; }.setup-note > view:last-child { display: flex; flex-direction: column; }.setup-title { font-size: 25rpx; font-weight: 700; }.setup-copy { margin-top: 3rpx; color: #697080; font-size: 22rpx; }
.submit-button { height: 92rpx; margin-top: 52rpx; border-radius: 14rpx; background: #3159d7; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 92rpx; }.submit-button[disabled] { background: #9eafe8; color: rgba(255,255,255,.88); }
.error-message { display: block; margin-top: 22rpx; color: #b84543; text-align: center; }

<view class="ledger-page">
  <view class="page-header"><text class="page-title">我的账本</text><button class="create-button" bindtap="handleCreate">创建账本</button></view>
  <text wx:if="{{loading}}" class="state-message">正在加载...</text>
  <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
  <view wx:for="{{ledgers}}" wx:key="id" class="ledger-item">
    <view class="ledger-info"><text class="ledger-name">{{item.name}}</text><text class="ledger-role">{{item.role === 'OWNER' ? '所有者' : '成员'}}</text></view>
    <view class="ledger-actions">
      <button wx:if="{{item.id === currentId}}" class="switch-button" data-ledger="{{item}}" bindtap="handleSwitch">进入账本</button>
      <button wx:else class="switch-button" data-ledger="{{item}}" bindtap="handleSwitch">切换</button>
      <button wx:if="{{item.role !== 'OWNER'}}" class="leave-button" data-id="{{item.id}}" bindtap="handleLeave">离开</button>
      <button wx:if="{{item.role === 'OWNER' && item.id === currentId}}" class="invite-button" bindtap="handleInvite">邀请家人</button>
    </view>
  </view>
  <view wx:if="{{invitation}}" class="invitation-result"><text>邀请已创建</text><text class="token">{{invitation.token}}</text><button open-type="share" class="share-button">分享邀请</button></view>
</view>

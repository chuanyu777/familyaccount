<view class="ledger-page">
  <view class="page-header"><view><text class="page-title">切换账本</text><text class="page-subtitle">选择要查看的家庭账本</text></view></view>
  <text wx:if="{{loading}}" class="state-message">正在加载...</text>
  <text wx:if="{{errorMessage}}" class="error-message">{{errorMessage}}</text>
  <view wx:for="{{ledgers}}" wx:key="id" class="ledger-item">
    <button class="ledger-choice" data-ledger="{{item}}" bindtap="handleSwitch"><view class="ledger-mark {{index % 3 === 1 ? 'green' : (index % 3 === 2 ? 'gold' : 'blue')}}"><view></view></view><view class="ledger-info"><text class="ledger-name">{{item.name}}</text><text class="ledger-role">{{item.role === 'OWNER' ? '所有者' : '家庭成员'}}</text></view><text wx:if="{{item.id === currentId}}" class="selected">✓</text><text wx:else class="arrow">›</text></button>
    <view class="ledger-actions"><button wx:if="{{item.id === currentId}}" class="current-entry" data-ledger="{{item}}" bindtap="handleSwitch">进入账本</button><button wx:if="{{item.role !== 'OWNER'}}" class="leave-button" data-id="{{item.id}}" bindtap="handleLeave">离开账本</button><button wx:if="{{item.role === 'OWNER' && item.id === currentId}}" class="invite-button" bindtap="handleInvite">邀请家人</button></view>
  </view>
  <button class="create-button" bindtap="handleCreate"><text>＋</text>创建新账本</button>
  <view wx:if="{{invitation}}" class="share-mask"><view class="invitation-result"><view class="share-visual">⌁</view><text class="share-title">邀请家人一起记账</text><text class="share-copy">邀请有效期为 7 天，每个邀请仅可使用一次</text><button open-type="share" class="share-button">发送给微信好友</button><text class="token">邀请口令：{{invitation.token}}</text></view></view>
</view>

.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }.title { display: block; font-size: 42rpx; font-weight: 600; }.sub, .state, .empty { display: block; margin-top: 8rpx; color: #6b7280; font-size: 24rpx; }.month { padding: 16rpx 22rpx; background: #fff; border: 1rpx solid #d7dce2; border-radius: 8rpx; }.state { padding: 70rpx 20rpx; text-align: center; }.error { color: #b91c1c; }.metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 20rpx; }.metrics view { min-height: 130rpx; padding: 22rpx; background: #fff; border-radius: 8rpx; box-sizing: border-box; }.metrics text, .metrics strong { display: block; }.metrics text { color: #6b7280; font-size: 24rpx; }.metrics strong { margin-top: 16rpx; font-size: 34rpx; }.section { margin-bottom: 20rpx; padding: 24rpx; background: #fff; border-radius: 8rpx; }.section-title { display: block; margin-bottom: 16rpx; font-size: 30rpx; font-weight: 600; }.snapshot { display: grid; gap: 12rpx; color: #374151; }.trend { display: flex; justify-content: space-between; gap: 12rpx; min-height: 66rpx; align-items: center; border-bottom: 1rpx solid #eef0f2; font-size: 24rpx; }.empty { padding: 20rpx 0 0; }

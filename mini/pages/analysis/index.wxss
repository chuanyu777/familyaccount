@import "../../styles/theme.wxss";
.analysis-summary { margin-top: 28rpx; padding: 30rpx; border-radius: 16rpx; color: #fff; background: #3159d7; }.analysis-summary text,.analysis-summary strong,.analysis-summary small { display: block; }.analysis-summary text { color: rgba(255,255,255,.72); font-size: 22rpx; }.analysis-summary strong { margin-top: 5rpx; font-size: 50rpx; }.analysis-summary small { margin-top: 14rpx; color: rgba(255,255,255,.72); font-size: 21rpx; }.chart-section,.category-section { margin-top: 32rpx; padding: 24rpx; border: 1rpx solid #dce1e9; border-radius: 14rpx; background: #fff; }.bar-chart { display: grid; grid-template-columns: repeat(6,1fr); height: 236rpx; padding-top: 14rpx; border-bottom: 1rpx solid #dce1e9; }.bar-group { display: grid; grid-template-rows: 1fr 34rpx; align-items: end; justify-items: center; }.bars { display: flex; align-items: flex-end; gap: 6rpx; height: 100%; }.bar { width: 14rpx; min-height: 6rpx; border-radius: 4rpx 4rpx 0 0; }.bar--income { background: #19765d; }.bar--expense { background: #b84543; }.bar-group > text { color: #697080; font-size: 17rpx; }.chart-legend { display: flex; justify-content: center; gap: 34rpx; padding-top: 14rpx; color: #697080; font-size: 19rpx; }.chart-legend text { display: flex; align-items: center; gap: 8rpx; }.chart-legend i { display: inline-block; width: 13rpx; height: 13rpx; border-radius: 50%; }.legend-income { background: #19765d; }.legend-expense { background: #b84543; }.category-layout { display: grid; grid-template-columns: 190rpx 1fr; align-items: center; gap: 25rpx; }.donut { display: flex; align-items: center; justify-content: center; width: 164rpx; height: 164rpx; border-radius: 50%; background: conic-gradient(#b84543 0 48%,#3159d7 48% 78%,#b47b18 78% 100%); }.donut > view { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 108rpx; flex-direction: column; border-radius: 50%; background: #fff; }.donut text { color: #697080; font-size: 16rpx; }.donut strong { margin-top: 2rpx; font-size: 18rpx; }.category-row { display: grid; grid-template-columns: 14rpx 1fr auto; align-items: center; gap: 10rpx; min-height: 56rpx; }.category-dot { width: 13rpx; height: 13rpx; border-radius: 50%; background: #b84543; }.dot-1 { background: #3159d7; }.dot-2 { background: #b47b18; }.rank-name { display: flex; min-width: 0; flex-direction: column; }.rank-name text { overflow: hidden; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }.rank-name small { color: #697080; font-size: 16rpx; }.category-amount { color: #151820; font-size: 19rpx; font-weight: 700; }.empty-inline { padding: 26rpx 0 8rpx; color: #8a92a1; text-align: center; font-size: 23rpx; }

<view class="screen-page analysis-page">
  <view class="ledger-head"><button class="ledger-selector" bindtap="openLedgerSwitcher">{{ledgerName}} <text class="chevron">⌄</text></button><picker mode="date" fields="month" value="{{month}}" bindchange="handleMonthInput"><view class="month-button">{{month}} <text class="chevron">⌄</text></view></picker></view>
  <view wx:if="{{loading}}" class="empty-state">正在加载分析…</view>
  <view wx:elif="{{errorMessage}}" class="empty-state state-error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view>
  <block wx:elif="{{summary}}">
    <view class="analysis-summary"><text>本月支出</text><strong>¥ {{snapshot ? snapshot.expense : '0.00'}}</strong><small>净资产 ¥{{summary.netWorth}}</small></view>
    <view class="chart-section"><view class="section-title"><text>近 6 个月收支</text><text class="section-title__meta">趋势</text></view><view class="bar-chart"><view wx:for="{{trend}}" wx:key="month" class="bar-group"><view class="bars"><view class="bar bar--income" style="height: {{item.incomeHeight}}%;"></view><view class="bar bar--expense" style="height: {{item.expenseHeight}}%;"></view></view><text>{{item.label}}</text></view></view><view class="chart-legend"><text><i class="legend-income"></i>收入</text><text><i class="legend-expense"></i>支出</text></view><view wx:if="{{!trend.length}}" class="empty-inline">暂无趋势数据</view></view>
    <view class="category-section"><view class="section-title"><text>支出分类</text><text class="section-title__meta">本月</text></view><view class="category-layout"><view class="donut"><view><text>本月支出</text><strong>¥{{snapshot ? snapshot.expense : '0.00'}}</strong></view></view><view class="category-rank"><view wx:for="{{breakdown}}" wx:key="categoryId" class="category-row"><view class="category-dot dot-{{index % 3}}"></view><view class="rank-name"><text>{{item.name}}</text><small>{{item.percent}}%</small></view><text class="category-amount">¥{{item.amount}}</text></view></view></view><view wx:if="{{!breakdown.length}}" class="empty-inline">本月暂无分类数据</view></view>
  </block>
  <ledger-switcher visible="{{switcherOpen}}" bindclose="closeLedgerSwitcher" />
  <tabbar current="analysis" />
</view>

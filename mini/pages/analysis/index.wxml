<view class="page"><view class="header"><view><text class="title">分析</text><text class="sub">按账本汇总</text></view><picker mode="date" fields="month" value="{{month}}" bindchange="handleMonthInput"><view class="month">{{month}}</view></picker></view><view wx:if="{{loading}}" class="state">正在加载分析…</view><view wx:elif="{{errorMessage}}" class="state error">{{errorMessage}}<button size="mini" bindtap="onShow">重试</button></view><view wx:elif="{{!summary}}" class="state">暂无分析数据</view><view wx:else><view class="metrics"><view><text>净资产</text><strong>¥{{summary.netWorth}}</strong></view><view><text>资产</text><strong>¥{{summary.totalAssets}}</strong></view><view><text>负债</text><strong>¥{{summary.totalLiabilities}}</strong></view><view><text>月供</text><strong>¥{{summary.monthlyPaymentTotal}}</strong></view></view><view class="section"><text class="section-title">月度快照 · {{month}}</text><view class="snapshot"><text>收入 ¥{{snapshot.income}}</text><text>支出 ¥{{snapshot.expense}}</text><text>结余 ¥{{snapshot.net}}</text></view></view><view class="section"><text class="section-title">收支趋势</text><view wx:for="{{trend}}" wx:key="month" class="trend"><text>{{item.month}}</text><text>收入 ¥{{item.income}} · 支出 ¥{{item.expense}} · 结余 ¥{{item.net}}</text></view><view wx:if="{{!trend.length}}" class="empty">暂无趋势数据</view></view><view class="section"><text class="section-title">支出分类</text><view wx:for="{{breakdown}}" wx:key="categoryId" class="trend"><text>{{item.name}}</text><text>¥{{item.cents}} · {{item.percent}}%</text></view><view wx:if="{{!breakdown.length}}" class="empty">本月暂无支出分类数据</view></view></view></view>

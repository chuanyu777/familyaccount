page {
  background: #f4f6f9;
}

.legal-page {
  padding: 32rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
}

.legal-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 24rpx;
}

.legal-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #131722;
}

.legal-updated {
  font-size: 22rpx;
  color: #8a92a1;
}

.legal-intro {
  display: block;
  margin-bottom: 32rpx;
  padding: 24rpx;
  border: 1rpx solid #dce1e9;
  border-radius: 16rpx;
  background: #fff;
  color: #3b4252;
  font-size: 26rpx;
  line-height: 1.75;
}

.legal-section {
  margin-bottom: 36rpx;
}

.legal-heading {
  display: block;
  margin-bottom: 14rpx;
  color: #131722;
  font-size: 30rpx;
  font-weight: 700;
}

.legal-paragraph {
  display: block;
  margin-bottom: 12rpx;
  color: #4a5163;
  font-size: 27rpx;
  line-height: 1.8;
}

.legal-footer {
  display: block;
  margin-top: 48rpx;
  color: #a2a8b3;
  font-size: 22rpx;
  text-align: center;
}
<view class="legal-page">
  <view class="legal-head">
    <text class="legal-title">{{doc.title}}</text>
    <text class="legal-updated">更新日期：{{doc.updated}}</text>
  </view>
  <text class="legal-intro">{{doc.intro}}</text>

  <view wx:for="{{doc.sections}}" wx:key="heading" class="legal-section">
    <text class="legal-heading">{{item.heading}}</text>
    <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="legal-paragraph">{{paragraph}}</text>
  </view>

  <text class="legal-footer">「一起记账」· 家庭财务一本账</text>
</view>